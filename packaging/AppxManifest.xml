<?xml version="1.0" encoding="utf-8"?>
<!--
  証拠番号付与ツール — MSIX マニフェスト（雛形）

  肝は <uap5:Extension Category="windows.appExecutionAlias">。これにより
  実行エイリアス「ltl-stamp.exe」が WindowsApps の PATH に登録され、外部の
  MCPクライアントが  ltl-stamp（引数 mcp オプション）  を stdio 起動できる（GUIはタイル/スタートから起動）。

  [TODO] と書いた箇所は Partner Center（ストア予約）で得た値・作成した画像に置換する。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <!-- [TODO] Name: Partner Center の予約名 / Publisher: Partner Center の Publisher ID
       （XMLではタグの属性の間にコメントを書けないため、ここにまとめて記載） -->
  <Identity
    Name="LeanTechLibrary.EvidenceMarker"
    Publisher="CN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>証拠番号付与ツール</DisplayName>
    <PublisherDisplayName>Lean Tech Library</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
  </Resources>

  <Capabilities>
    <!-- Python(フリーズexe)の full-trust 実行に必須。Storeでは要審査だが取得可。 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="ltl-stamp.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="証拠番号付与ツール"
        Description="PDFに証拠番号（甲第○号証等）を付与する"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <!-- ★ これが MCP の口：ltl-stamp（引数 mcp オプション） を外部から起動できるようにする -->
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="ltl-stamp.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
